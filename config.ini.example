# S.A.T-APRS - Plantilla de configuración de la estación
#
# Copie este archivo como «config.ini» y edítelo:
#     cp config.ini.example config.ini
#
# «config.ini» es local a cada instalación (no se versiona en git). El agente
# aprs_sat.py lo lee en cada ciclo y la consola web lo reescribe al guardar la
# configuración desde el panel.

[GPSD]
host = localhost
port = 2947

[OpenWeatherMap]
# Clave API para la baliza meteorológica WX. Sin clave no se emite baliza:
# el agente nunca transmite datos meteorológicos inventados.
apiKey =

[WeatherAPI]
# Clave API de WeatherAPI.com para las alertas de pronóstico a 24-72 h (opcional)
apiKey =
# Umbral de viento fuerte en nudos
thresholdWindKts = 25.0
# Umbral de temperatura mínima en °C para heladas
thresholdTempMinC = 0.0
# Umbral de lluvia acumulada diaria en mm
thresholdRainMm = 20.0
# Días de pronóstico a consultar (1 a 3)
forecastDays = 3

[LocalWeather]
# Estación meteorológica propia: una URL http(s):// o un archivo .json con las
# lecturas. Déjelo vacío si no tiene estación local.
# («simulated» solo genera datos con «aprs_sat.py --simulate», que no transmite.)
source =
thresholdWindKts = 20.0
thresholdTempMaxC = 35.0
thresholdTempMinC = 5.0
thresholdRainMm = 10.0
interval = 300

[Fallback]
# Coordenadas de la estación cuando el receptor GPS no tiene fijación
latitude = 40.416775
longitude = -3.703790
altitude = 657.0

[Alerts]
# Radio (km) alrededor de la estación para anunciar sismos
filterRadiusKm = 200.0
# Magnitud mínima para anunciar un sismo por APRS
minMagnitude = 3.0
# Antigüedad máxima (horas) de un sismo para anunciarlo
maxQuakeAgeHours = 24.0
# Zonas de los avisos meteorológicos oficiales (MeteoAlarm/AEMET), separadas por
# comas y tal como aparecen en los avisos. Ejemplo: Sevilla,Cadiz,Huelva
# Vacío = no se difunden avisos meteorológicos oficiales.
meteoAreaFilter =

[APRS]
# Su indicativo con SSID (ej. EA7XXX-13). Con el valor de plantilla N0CALL
# el sistema NO transmite.
callsign = N0CALL
# Passcode de APRS-IS correspondiente a su indicativo. Si no coincide, no se
# inyecta nada en APRS-IS (la emisión por RF no lo necesita).
passcode =
serverIp = euro.aprs2.net
serverPort = 14580
# TNC KISS sobre TCP (Direwolf)
kissTcpHost = localhost
kissTcpPort = 8001
# Canales por los que transmite el agente
aprsIsEnabled = true
rfEnabled = true
# Ruta de los paquetes emitidos por radio
rfPath = WIDE1-1,WIDE2-1
