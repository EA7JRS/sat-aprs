# S.A.T.-APRS · Variables de entorno de la consola web
# Copie este archivo como «.env» y edítelo:  cp .env.example .env

# --- Emisión -----------------------------------------------------------------
# La consola NO transmite nada por defecto. Póngalo en «on» únicamente en la
# estación real, con su indicativo y passcode ya configurados. Aun activada,
# los datos simulados o de prueba nunca salen al aire.
# Si ejecuta también el agente aprs_sat.py, deje aquí «off» para no duplicar
# las balizas: el agente es quien transmite.
SAT_APRS_TX="off"

# --- Administración ----------------------------------------------------------
# Correos (separados por comas) de las cuentas de Firebase que administran la
# estación. Deben tener el correo verificado. Solo un administrador puede
# guardar la configuración en disco, editar los archivos del sistema o, con la
# emisión activada, provocar transmisiones.
SAT_ADMIN_EMAILS=""

# Token local de administrador (opcional). Permite administrar la estación sin
# Internet, cuando Firebase no está disponible. Genere uno largo y aleatorio:
#     openssl rand -hex 32
# y guárdelo en el navegador de la estación (consola de desarrollador):
#     localStorage.setItem('sat_admin_token', '<el token>')
SAT_ADMIN_TOKEN=""

# «on» = las peticiones hechas desde el propio equipo (pantalla de la estación)
# se consideran del administrador. No lo active tras un proxy mal configurado.
SAT_TRUST_LOCALHOST="off"

# --- Red ---------------------------------------------------------------------
# Puerto e interfaz de escucha. HOST="127.0.0.1" limita el acceso al propio
# equipo (recomendado si publica la consola mediante un proxy inverso con TLS).
PORT="3000"
HOST="0.0.0.0"

# --- Servicios ---------------------------------------------------------------
# GEMINI_API_KEY: necesaria para el análisis de incendios con Gemini.
# AI Studio la inyecta automáticamente desde el panel de secretos.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL donde está alojada la aplicación (AI Studio la inyecta).
APP_URL="MY_APP_URL"
